{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.8-flash",
  "mcp": {
    "ifood": {
      "type": "remote",
      "url": "https://consumer-mcp.ifood.com.br/marketplace",
      "enabled": true,
      "oauth": {
        "clientId": "{file:./backend/integrations/.local/ifood-client-id.txt}",
        "clientSecret": "{file:./backend/integrations/.local/ifood-client-secret.txt}",
        "scope": "mcp.discovery.search.read",
        "redirectUri": "http://localhost:8080/callback"
      },
      "timeout": 10000
    }
  }
}
